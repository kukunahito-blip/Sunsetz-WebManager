{
  "name": "sunsetz-webmanager",
  "version": "1.2.102",
  "description": "Adaptation of Sunsetz filebrowser in an app",
  "license": "ISC",
  "author": "Hitokuna <kukunahito@gmail.com>",
  "type": "commonjs",
  "main": "main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electronmon .",
    "dist": "electron-builder",
    "version:bump": "npm version patch -m \"Build: release %s\"",
    "publish:draft": "git add . && npm version patch --force -m \"Build: release %s\" && git push origin main --follow-tags && for /f \"tokens=*\" %a in ('node -p \"require('./package.json').version\"') do gh release create v%a --draft --generate-notes",
    "publish:final": "git add . && npm version patch --force -m \"Build: release %s\" && git push origin main --follow-tags && for /f \"tokens=*\" %a in ('node -p \"require('./package.json').version\"') do gh release create v%a --generate-notes"
  },
  "build": {
    "appId": "com.sunsetz.webmanager",
    "productName": "WebManager-App",
    "files": [
      "**/*",
      "!build/*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "kukunahito-blip",
        "repo": "Sunsetz-WebManager",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "kukunahito@gmail.com",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "electron-version": "^2.0.1",
    "electronmon": "^2.0.4"
  }
}
